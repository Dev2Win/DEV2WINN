# ─────────────────────────────────────────────────────────────
# Dev2Win — root example env. Copy per service as needed.
# Each service also has its own .env.example (client/, server/, ai/).
# ─────────────────────────────────────────────────────────────

# MySQL (server)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dev2win
MYSQL_PASSWORD=dev2win
MYSQL_DATABASE=dev2win

# Redis (server, ai, worker)
REDIS_URL=redis://localhost:6379

# Optional AI direct DB connector. Prefer main API connector; direct mode is allowlisted.
AI_DB_DIRECT_ENABLED=false
AI_DB_ALLOWED_PROCEDURES=sp_user_get_by_id,sp_roadmap_get_for_user,sp_lms_status_get_for_user,sp_progress_summary_get_for_user,sp_matching_recommendations_for_user

# Qdrant (ai)
QDRANT_URL=http://localhost:6333

# Auth / sessions (server)
SESSION_SECRET=change-me-32-bytes-min
COOKIE_DOMAIN=localhost

# OAuth (server)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:4000

# Service-to-service JWT (server <-> ai)
SERVICE_JWT_SECRET=change-me-service-secret

# Anthropic (ai)
ANTHROPIC_API_KEY=
# Back-compat alias if a local env already uses API_KEY for Anthropic.
API_KEY=

# Google Generative AI (ai embeddings + web grounding)
GOOGLE_API_KEY=

# Optional Anthropic MCP connector servers for ai.
# JSON list of remote URL MCP servers.
ANTHROPIC_MCP_SERVERS_JSON=[]
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20
ANTHROPIC_MCP_DEFER_LOADING=true

# Stream video (server/client)
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_SECRET_KEY=

# URLs
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000
AI_URL=http://localhost:8000
