NODE_ENV=development
PORT=4000

# MySQL  (docker-compose maps host 3307 -> container 3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=dev2win
MYSQL_PASSWORD=dev2win
MYSQL_DATABASE=dev2win

# Redis
REDIS_URL=redis://localhost:6379

# Auth
SESSION_SECRET=change-me-at-least-32-characters-long
COOKIE_DOMAIN=localhost

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:4000

# Service-to-service (server <-> ai)
SERVICE_JWT_SECRET=change-me-service-secret
AI_URL=http://localhost:8000

# CORS
CLIENT_URL=http://localhost:3000
