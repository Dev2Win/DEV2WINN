ENV=development
PORT=8000

# Anthropic
ANTHROPIC_API_KEY=
# Root .env.local may use API_KEY for Anthropic; ANTHROPIC_API_KEY wins.
API_KEY=
# Google Generative AI: embeddings + web search grounding
GOOGLE_API_KEY=
# Model routing (token efficiency — see docs/AI_AGENT.md)
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-20250514
MODEL_DEEP=claude-opus-4-20250514
WEB_SEARCH_MODEL=gemini-2.5-flash

# Optional Anthropic MCP connector servers.
# JSON list, remote URL servers only. Example:
# ANTHROPIC_MCP_SERVERS_JSON=[{"type":"url","name":"docs","url":"https://example.com/mcp","authorization_token":"token"}]
ANTHROPIC_MCP_SERVERS_JSON=[]
ANTHROPIC_MCP_BETA=mcp-client-2025-11-20
ANTHROPIC_MCP_DEFER_LOADING=true

# Qdrant
QDRANT_URL=http://localhost:6333

# Service-to-service auth (must match server's SERVICE_JWT_SECRET)
SERVICE_JWT_SECRET=change-me-service-secret
SERVER_URL=http://localhost:4000

# Redis (token budgets)
REDIS_URL=redis://localhost:6379

# AI DB connector. Direct DB mode is off by default; API connector is preferred.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=dev2win
MYSQL_PASSWORD=dev2win
MYSQL_DATABASE=dev2win
AI_DB_DIRECT_ENABLED=false
AI_DB_ALLOWED_PROCEDURES=sp_user_get_by_id,sp_roadmap_get_for_user,sp_lms_status_get_for_user,sp_progress_summary_get_for_user,sp_matching_recommendations_for_user

# Local FAISS RAG
RAG_INDEX_PATH=.rag/faiss.index
RAG_STORE_PATH=.rag/chunks.json
EMBEDDING_MODEL=models/embedding-001
